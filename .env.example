# Variable names only. Copy to .env and fill in. Never commit real values.
ES_URL=
ES_API_KEY=
OPENAI_API_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=curb-cut-api
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_OTEL_EXPORTER_URL=
NEXT_PUBLIC_SEARCH_BACKEND=
# Live mode: the web app uses the API for search, re-planning, changes, reports and questions.
# Leave NEXT_PUBLIC_API_MODE empty to run entirely on the device (the default demo).
NEXT_PUBLIC_API_MODE=
# Comma-separated browser origins the API accepts (default: local dev server).
CORS_ORIGINS=
# If set, organizer actions need this value typed on the organizer dashboard. Not set = open (local demo only).
ORGANIZER_KEY=
# Inference endpoint for semantic_text (empty = Serverless default, which includes Jina embeddings).
ES_INFERENCE_ID=
# 0 stops the API loading the programme into Elasticsearch on startup.
ES_AUTO_INGEST=1
# Kibana URL of the Serverless project, used by elastic/setup.py.
KIBANA_URL=
